# --- LLM / embeddings -------------------------------------------------
GEMINI_API_KEY=your-key-here
# Free-tier daily request caps differ per model. gemini-2.5-flash writes better
# questions but allows only ~20 requests/day; flash-lite is far more generous.
LLM_MODEL=gemini-3.1-flash-lite

# Embeddings: auto | local | gemini | hashing
#   local   - Model2Vec static model, CPU, no API calls (default, indexes a book in seconds)
#   gemini  - gemini-embedding-001; better quality, but the free tier is heavily rate limited
#   hashing - dependency-free fallback used by the tests
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=minishlab/potion-base-8M
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- storage ----------------------------------------------------------
# DATABASE_URL=sqlite:///./data/app.db
# KNOWLEDGE_BASE_DIR=./data/knowledge_base
# VECTOR_STORE_DIR=./data/vector_store

# --- retrieval tuning -------------------------------------------------
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=220
# Chunk quality filter: drop a chunk below this word count or letter/whitespace
# ratio, or at/above this many dot-leader lines or "(1998)" citation years.
CHUNK_FILTER_MIN_WORDS=40
CHUNK_FILTER_MIN_ALPHA_RATIO=0.55
CHUNK_FILTER_TOC_HITS=3
CHUNK_FILTER_REFERENCE_YEARS=4
RETRIEVAL_TOP_K=6
DENSE_WEIGHT=0.7
RETRIEVAL_MMR_LAMBDA=0.65

# --- interview --------------------------------------------------------
DEFAULT_QUESTION_COUNT=6
MAX_QUESTION_COUNT=12

# --- app --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# OFFLINE_MODE=false
